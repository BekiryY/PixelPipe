module DVI_TX_Top (
  pix_clk,
  serial_clk,
  hdmi4_rst_n,
  tp0_de_in,
  tp0_vs_in,
  tp0_hs_in,
  data_out_controlled,
  O_tmds_clk_p,
  O_tmds_clk_n,
  n36_6,
  O_tmds_data_p,
  O_tmds_data_n
)
;
input pix_clk;
input serial_clk;
input hdmi4_rst_n;
input tp0_de_in;
input tp0_vs_in;
input tp0_hs_in;
input [7:0] data_out_controlled;
output O_tmds_clk_p;
output O_tmds_clk_n;
output n36_6;
output [2:0] O_tmds_data_p;
output [2:0] O_tmds_data_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .pix_clk(pix_clk),
    .serial_clk(serial_clk),
    .hdmi4_rst_n(hdmi4_rst_n),
    .tp0_de_in(tp0_de_in),
    .tp0_vs_in(tp0_vs_in),
    .tp0_hs_in(tp0_hs_in),
    .data_out_controlled(data_out_controlled[7:0]),
    .O_tmds_clk_p(O_tmds_clk_p),
    .O_tmds_clk_n(O_tmds_clk_n),
    .n36_6(n36_6),
    .O_tmds_data_p(O_tmds_data_p[2:0]),
    .O_tmds_data_n(O_tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
